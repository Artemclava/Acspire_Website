# --- Frontend Environment Variables ---
VITE_API_URL=http://localhost:3001
VITE_SHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# --- Backend Server Environment Variables ---
PORT=3001
