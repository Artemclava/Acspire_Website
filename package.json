{
  "name": "acspire-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev:website": "npm --prefix apps/website run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:server": "npm --prefix server run start",
    "dev:all": "concurrently \"npm run dev:website\" \"npm run dev:admin\" \"npm run dev:server\"",
    "build:website": "npm --prefix apps/website run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:all": "npm run build:website && npm run build:admin",
    "start:server": "npm --prefix server run start"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
